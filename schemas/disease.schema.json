{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Disease Schema",
  "description": "Schema for disease YAML files in data/mms/{code}.yaml",
  "type": "object",
  "required": [
    "entity_uri",
    "code",
    "title_en",
    "definition_en",
    "parent_code",
    "children_codes",
    "pathophysiology_en",
    "symptoms",
    "differential_diagnosis",
    "risk_factors",
    "drugs",
    "vector_text_en",
    "stats",
    "ai_enriched",
    "last_updated"
  ],
  "properties": {
    "entity_uri": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "title_en": {
      "type": "string"
    },
    "definition_en": {
      "type": "string"
    },
    "parent_code": {
      "type": ["string", "null"]
    },
    "children_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pathophysiology_en": {
      "type": ["string", "null"]
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "grade", "probability", "note"],
        "properties": {
          "id": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "enum": ["ALWAYS", "VERY_COMMON", "COMMON", "OCCASIONAL", "RARE", "NEVER"]
          },
          "probability": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "note": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "differential_diagnosis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drugs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vector_text_en": {
      "type": ["string", "null"]
    },
    "stats": {
      "type": "object",
      "required": [
        "mortality_global_annual",
        "dalys_global",
        "incidence_rate_per_100k",
        "active_clinical_trials",
        "child_code_count",
        "research_link_count"
      ],
      "properties": {
        "mortality_global_annual": {
          "type": ["number", "null"]
        },
        "dalys_global": {
          "type": ["number", "null"]
        },
        "incidence_rate_per_100k": {
          "type": ["number", "null"]
        },
        "active_clinical_trials": {
          "type": ["integer", "null"]
        },
        "child_code_count": {
          "type": "integer"
        },
        "research_link_count": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "ai_enriched": {
      "type": "boolean"
    },
    "last_updated": {
      "type": "string"
    }
  }
}
